# Voice Assistant Environment Configuration Template

# OpenWeatherMap API Key (Register at https://openweathermap.org/ for a free key)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# SMTP Configuration for Voice Email Sending
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_FROM_EMAIL=your_email@gmail.com

# Debug & Simulation Settings
# If DEBUG_MODE=True, the assistant will write outgoing emails to the data/outbox/ directory 
# instead of trying to authenticate and connect to the SMTP server.
DEBUG_MODE=True
